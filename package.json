{
    "name": "elid-oauth-provider",
    "version": "1.0.9",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "start": "node server.mjs",
        "check": "node --check server.mjs && find src -name '*.mjs' -print0 | xargs -0 -n1 node --check",
        "lint": "eliware-test --lint",
        "test": "eliware-test",
        "typecheck": "node bin/check.mjs",
        "pack": "npm pack --dry-run",
        "client": "node bin/elid-client.mjs",
        "oidc:keys": "node bin/elid-oidc-keys.mjs",
        "test:gaps": "npm test"
    },
    "dependencies": {
        "@eliware/common": "^2.0.0",
        "@eliware/mysql": "^2.0.0",
        "@eliware/snowflake": "^1.1.5",
        "bcryptjs": "^3.0.2",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "mysql2": "^3.24.2"
    },
    "devDependencies": {
        "@eliware/test": "^2.0.0"
    }
}
