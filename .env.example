MYSQL_HOSTNAME=mysql
MYSQL_USERNAME=elid
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=elid

HTTP_PORT=8080
NODE_ENV=production
TRUST_PROXY=true
# Comma-separated public authority hostnames served by this instance.
OAUTH_AUTHORITY_HOSTS=auth.purinton.us,auth.eliware.org,auth.discommand.com,auth.tasklit.com,auth.pianotomidi.com
# Optional canonical issuer for tokens. Metadata follows the requested allowlisted host.
# OAUTH_ISSUER=https://auth.eliware.org
# Set true only for local development; never in production.
ENABLE_TEST_ROUTES=false

# Rate limits
GLOBAL_RATE_WINDOW_MS=60000
GLOBAL_RATE_MAX=1000
ADMIN_LOGIN_RATE_WINDOW_MS=900000
ADMIN_LOGIN_RATE_MAX=20
ACCOUNT_LOGIN_RATE_WINDOW_MS=900000
ACCOUNT_LOGIN_RATE_MAX=30
